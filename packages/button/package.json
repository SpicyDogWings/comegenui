    "tsx": "^4.23.1",
    "vite": "^8.0.8",
    "vitest": "^4.1.9",
    "vue": "3.6.0-rc.11",
    "@comegenui/tokens": "workspace:*",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
