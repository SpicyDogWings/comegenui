#!/bin/bash
# Hook pre-push (versionado). Se activa una vez por clon:
#   git config core.hooksPath .githooks
#
# Corre el gate completo (guard.sh --full): impacto + tipos + contrato + build de
# la lib + tests + docs + build del sitio. Bloquea el push si algo está roto.
# Saltear de forma puntual: `git push --no-verify`.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

./scripts/guard.sh --full
