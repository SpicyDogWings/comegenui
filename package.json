{
  "name": "comegenui",
  "version": "5.2.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:docs:lib": "COMEGEN_CONFIGS=esm-shared COMEGEN_NO_ZIP=1 pnpm build:lib",
    "deploy:docs": "pnpm build && vercel link --cwd docs/site/.vitepress/dist --project comegenui-docs --yes && vercel --cwd docs/site/.vitepress/dist --prod --yes",
    "docs:versions": "node scripts/docs-versions.mjs",
    "deploy:docs:versions": "pnpm docs:versions && vercel link --cwd docs/site/.vitepress/dist-versions --project comegenui-docs --yes && vercel --cwd docs/site/.vitepress/dist-versions --prod --yes",
    "dev": "pnpm build:docs:lib && pnpm docs:compose && pnpm site:sync && vitepress dev docs/site",
    "build": "pnpm build:docs:lib && pnpm docs:compose && pnpm site:sync && vitepress build docs/site",
    "preview": "vitepress preview docs/site",
    "site:sync": "tsx --tsconfig tsconfig.app.json src/plugins/cu-tokens/cli/vitepress.mjs",
    "build:lib": "pnpm exec tsx --tsconfig tsconfig.build-lib.json build-lib.ts",
    "type-check": "vue-tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "guard": "bash scripts/guard.sh",
    "mutation": "node scripts/mutation-check.mjs",
    "contract": "node scripts/contract.mjs",
    "contract:update": "node scripts/contract.mjs --update",
    "impact": "node scripts/impact.mjs",
    "docs:compose": "node scripts/docs-compose.mjs",
    "docs:freeze": "node scripts/docs-freeze.mjs"
  },
  "dependencies": {
    "@vueuse/core": "^14.2.1",
    "archiver": "^7.0.1",
    "color2k": "^2.0.3",
    "dompurify": "^3.4.14",
    "esbuild": "^0.28.1",
    "glob": "^13.0.6",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.11",
    "pinia": "^4.0.3",
    "vite-plugin-inspect": "^11.4.1",
    "vue": "3.6.0-rc.11",
    "vue-router": "^5.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.103",
    "@playwright/mcp": "^0.0.80",
    "@tsconfig/node24": "^24.0.4",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^24.12.2",
    "@unocss/preset-icons": "^66.6.8",
    "@unocss/preset-mini": "^66.6.8",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.9",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "fast-glob": "^3.3.3",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^8.0.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "shiki": "^2.1.0",
    "tsx": "^4.23.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "unocss": "^66.6.8",
    "vite": "^8.0.8",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.9",
    "vue-component-meta": "^3.3.11",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@12.0.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.20.0",
      "onFail": "download"
    }
  }
}
